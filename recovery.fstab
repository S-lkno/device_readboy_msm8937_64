# mount point   fstype    device                                        flags
/system         ext4      /dev/block/bootdevice/by-name/system          flags=display=System;backup=1;wipeingui
/cache          ext4      /dev/block/bootdevice/by-name/cache           flags=display=Cache;backup=1;wipeingui
/data           ext4      /dev/block/bootdevice/by-name/userdata        flags=display=Data;backup=1;wipeingui;encryptable=footer;userdataencryptbackup=1
/persist        ext4      /dev/block/bootdevice/by-name/persist         flags=display=Persist;backup=1
/oem            ext4      /dev/block/bootdevice/by-name/oem             flags=display=OEM;backup=1;wipeingui
/misc           emmc      /dev/block/bootdevice/by-name/misc            flags=display=Misc;backup=0
/modem          emmc      /dev/block/bootdevice/by-name/modem           flags=display=Modem;backup=1;wipeingui
# 引导相关（建议备份）
/boot           emmc      /dev/block/bootdevice/by-name/boot            flags=display=Boot;backup=1
/recovery       emmc      /dev/block/bootdevice/by-name/recovery        flags=display=Recovery;backup=1
/aboot          emmc      /dev/block/bootdevice/by-name/aboot           flags=display=Aboot;backup=1
/abootbak       emmc      /dev/block/bootdevice/by-name/abootbak        flags=display=Abootbak;backup=1
/rpm            emmc      /dev/block/bootdevice/by-name/rpm             flags=display=RPM;backup=1
/rpmbak         emmc      /dev/block/bootdevice/by-name/rpmbak          flags=display=RPMbak;backup=1
/tz             emmc      /dev/block/bootdevice/by-name/tz              flags=display=TZ;backup=1
/tzbak          emmc      /dev/block/bootdevice/by-name/tzbak           flags=display=TZbak;backup=1
/sbl1           emmc      /dev/block/bootdevice/by-name/sbl1            flags=display=SBL1;backup=1
/sbl1bak        emmc      /dev/block/bootdevice/by-name/sbl1bak         flags=display=SBL1bak;backup=1
/cmnlib         emmc      /dev/block/bootdevice/by-name/cmnlib          flags=display=CMNLib;backup=1
/cmnlibbak      emmc      /dev/block/bootdevice/by-name/cmnlibbak       flags=display=CMNLibbak;backup=1
/cmnlib64       emmc      /dev/block/bootdevice/by-name/cmnlib64        flags=display=CMNLib64;backup=1
/cmnlib64bak    emmc      /dev/block/bootdevice/by-name/cmnlib64bak     flags=display=CMNLib64bak;backup=1
/keymaster      emmc      /dev/block/bootdevice/by-name/keymaster       flags=display=Keymaster;backup=1
/keymasterbak   emmc      /dev/block/bootdevice/by-name/keymasterbak    flags=display=Keymasterbak;backup=1
/devcfg         emmc      /dev/block/bootdevice/by-name/devcfg          flags=display=Devcfg;backup=1
/devcfgbak      emmc      /dev/block/bootdevice/by-name/devcfgbak       flags=display=Devcfgbak;backup=1
/sec            emmc      /dev/block/bootdevice/by-name/sec             flags=display=Sec;backup=1
/ssd            emmc      /dev/block/bootdevice/by-name/ssd             flags=display=SSD;backup=1
/fsg            emmc      /dev/block/bootdevice/by-name/fsg             flags=display=FSG;backup=1
/fsc            emmc      /dev/block/bootdevice/by-name/fsc             flags=display=FSC;backup=1
/dsp            emmc      /dev/block/bootdevice/by-name/dsp             flags=display=DSP;backup=1

# 一般不备份或不宜备份的分区
/modemst1       emmc      /dev/block/bootdevice/by-name/modemst1        flags=display=Modemst1;backup=0
/modemst2       emmc      /dev/block/bootdevice/by-name/modemst2        flags=display=Modemst2;backup=0
/limits         emmc      /dev/block/bootdevice/by-name/limits          flags=display=Limits;backup=0
/mota           emmc      /dev/block/bootdevice/by-name/mota            flags=display=Mota;backup=0
/dip            emmc      /dev/block/bootdevice/by-name/dip             flags=display=Dip;backup=0
/mdtp           emmc      /dev/block/bootdevice/by-name/mdtp            flags=display=MDTP;backup=0
/syscfg         emmc      /dev/block/bootdevice/by-name/syscfg          flags=display=Syscfg;backup=0
/mcfg           emmc      /dev/block/bootdevice/by-name/mcfg            flags=display=Mcfg;backup=0
/apdp           emmc      /dev/block/bootdevice/by-name/apdp            flags=display=Apdp;backup=0
/msadp          emmc      /dev/block/bootdevice/by-name/msadp           flags=display=Msadp;backup=0
/dpo            emmc      /dev/block/bootdevice/by-name/dpo             flags=display=Dpo;backup=0
/logdump        emmc      /dev/block/bootdevice/by-name/logdump         flags=display=Logdump;backup=0
/DDR            emmc      /dev/block/bootdevice/by-name/DDR             flags=display=DDR;backup=0
/devinfo        emmc      /dev/block/bootdevice/by-name/devinfo         flags=display=Devinfo;backup=0
/keystore       emmc      /dev/block/bootdevice/by-name/keystore        flags=display=Keystore;backup=0
/config         emmc      /dev/block/bootdevice/by-name/config          flags=display=Config;backup=0

# 外置存储
/sdcard1        auto      /dev/block/mmcblk1p1                         flags=display=MicroSD;storage;wipeingui;removable;fsflags=utf8
/usb-otg        auto      /dev/block/sda1                              flags=display=USB-OTG;storage;wipeingui;removable;fsflags=utf8
